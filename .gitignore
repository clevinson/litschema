# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.env

# Build/test outputs
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
site/
static-site/
.litschema/

# Local agent/editor state
.claude/
.codex/
.idea/
.DS_Store

# Project data generated by users
papers/
data/
*.pdf

# ...but test fixture projects are source, not user data. Without this the
# `data/` rule silently drops fixture files, and tests that pass locally on
# untracked files fail in CI with nothing to point at. Generated runtime
# caches inside a fixture stay ignored — they are rebuilt, not authored.
!tests/fixtures/**
tests/fixtures/**/.litschema/

# AI tooling
.roborev.toml
